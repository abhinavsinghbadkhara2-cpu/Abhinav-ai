rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidChat(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.languageHint is string &&
             data.languageHint in ['auto', 'en', 'hi'] &&
             data.lastMessagePreview is string &&
             data.lastMessagePreview.size() <= 200 &&
             data.messageCount is int &&
             data.messageCount >= 0 &&
             data.messageCount <= 2000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidMessage(data, userId, chatId) {
      return data.userId is string &&
             data.userId == userId &&
             data.chatId is string &&
             data.chatId == chatId &&
             data.role is string &&
             data.role in ['user', 'model'] &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 32000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /users/{userId}/chats/{chatId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(chatId);

      allow create: if isOwner(userId) &&
                       isValidId(chatId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'title',
                         'languageHint',
                         'lastMessagePreview',
                         'messageCount',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'title',
                         'languageHint',
                         'lastMessagePreview',
                         'messageCount',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidChat(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(chatId) &&
                       isValidChat(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title',
                         'languageHint',
                         'lastMessagePreview',
                         'messageCount',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(chatId);

      match /messages/{messageId} {
        allow list: if isOwner(userId) && isValidId(chatId);
        allow get: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);

        allow create: if isOwner(userId) &&
                         isValidId(chatId) &&
                         isValidId(messageId) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)) &&
                         incoming().keys().hasAll(['userId', 'chatId', 'role', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'chatId', 'role', 'text', 'createdAt']) &&
                         isValidMessage(incoming(), userId, chatId);

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(chatId) && isValidId(messageId);
      }
    }
  }
}
